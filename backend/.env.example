DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/loan_management?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_WORKFLOW_TIMEOUT_MS=300000
# Eligibility call; includes an optional LLM explanation summary.
AI_ELIGIBILITY_TIMEOUT_MS=150000
# Set to false to use only the deterministic decision explanation (no LLM summary).
AI_LLM_EXPLANATION=true
# Upload check (ID proof / payslip / bank statement). Scanned PDFs need OCR time.
DOCUMENT_VALIDATION_TIMEOUT_MS=180000
UPLOAD_DIR="./uploads"
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:5174"
NODE_ENV="development"
DEMO_OFFICER_PASSWORD="DemoPass123!"
DEMO_AUDITOR_PASSWORD="DemoPass123!"
DEMO_APPLICANT_PASSWORD="DemoPass123!"
