{
  "name": "bnk02-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "nodemon src/server.js",
    "db:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/postgres/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "test": "node --test ../tests/backend/api.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemon": "^3.1.14",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "prisma@6.19.0": true
  }
}
