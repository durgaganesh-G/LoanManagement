OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1024
LANGGRAPH_CHECKPOINT_DB=./state/langgraph-checkpoints.sqlite
AI_RULEBOOK_VERSION=DEMO-1
AI_ELIGIBLE_BELOW_DTI=35
AI_NOT_ELIGIBLE_ABOVE_DTI=40

# Optional: a locally installed vision model (for example llama3.2-vision or llava).
# When set, scanned or photo-only PDFs are also shown to it; it can only reject
# (for example a photo of a car), never accept a document on its own.
OLLAMA_VISION_MODEL=
